# Copier vers .env : cp .env.example .env
# ComeUp Deployable : renseigner les variables dans l’interface ou via ce fichier.

NODE_ENV=development
PORT=3000

# Obligatoire en production (sinon sessions prévisibles)
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire

# Derrière un reverse-proxy (Render, Railway, etc.) pour cookie secure + IP client
TRUST_PROXY=false

# Vide = SQLite (fichier data/cars.db) — idéal démo ComeUp sans base externe
# Renseigné = MongoDB (Atlas, Docker, etc.) — déploiement “full cloud”
MONGODB_URI=

# URL publique du site (sans slash final) — obligatoire pour Stripe Checkout (retours success/cancel)
PUBLIC_APP_URL=http://localhost:3000

# Stripe (paiement en ligne) — clé secrète jamais côté navigateur ; webhook pour confirmer les paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
