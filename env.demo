# Fichier de référence démo (versionné). Pour tester en local :
#   cp env.demo .env
# Puis : npm start

NODE_ENV=development
PORT=3000
SESSION_SECRET=demo-comeup-changez-moi-en-production-min-32-caracteres
TRUST_PROXY=false

# Laisser vide pour SQLite (démonstration immédiate).
MONGODB_URI=

# Pour tester Stripe en local : https://stripe.com/docs/stripe-cli
PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
